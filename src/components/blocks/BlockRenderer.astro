---
// Ein Renderer je Blocktyp, portiert aus legacy/plattform/js/content-blocks.js.
// Unbekannte Blocktypen werden uebersprungen und gewarnt, nicht abgebrochen.
import KurzErklaert from './KurzErklaert.astro';
import IconFakten from './IconFakten.astro';
import Prozess from './Prozess.astro';
import Textabschnitt from './Textabschnitt.astro';
import Bild from './Bild.astro';
import Beispiel from './Beispiel.astro';
import Liste from './Liste.astro';
import Evidenz from './Evidenz.astro';
import Zitat from './Zitat.astro';
import Faq from './Faq.astro';
import ToolEinbindung from './ToolEinbindung.astro';
import Perspektive from './Perspektive.astro';
import Verknuepfungen from './Verknuepfungen.astro';
import Empfehlung from './Empfehlung.astro';
import { berechneAbschnitte, type Baustein } from '../../lib/bausteine';

interface Props {
  bloecke?: Baustein[];
}

const { bloecke = [] } = Astro.props as Props;
const abschnitte = berechneAbschnitte(bloecke);
---

<div class="stack">
  {abschnitte.map(({ block: b, titel, id }) => (
    <section class="baustein-sektion" id={id}>
      <p class="baustein-sektion__label">{titel}</p>
      {b.type === 'kurz_erklaert' && <KurzErklaert text={b.text as string} />}
      {b.type === 'icon_fakten' && <IconFakten fakten={b.fakten as any} />}
      {b.type === 'prozess' && <Prozess schritte={b.schritte as any} />}
      {b.type === 'textabschnitt' && <Textabschnitt text={b.text as string} />}
      {b.type === 'bild' && (
        <Bild bild={b.bild as string} alt={b.alt as string} bildunterschrift={b.bildunterschrift as string} />
      )}
      {b.type === 'beispiel' && <Beispiel text={b.text as string} ergebnis={b.ergebnis as string} />}
      {b.type === 'liste' && <Liste punkte={b.punkte as string[]} />}
      {b.type === 'evidenz' && (
        <Evidenz text={b.text as string} link_url={b.link_url as string} link_label={b.link_label as string} />
      )}
      {b.type === 'zitat' && <Zitat text={b.text as string} quelle={b.quelle as string} />}
      {b.type === 'faq' && <Faq eintraege={b.eintraege as any} />}
      {b.type === 'tool_einbindung' && <ToolEinbindung tool={b.tool as string} />}
      {b.type === 'perspektive' && (
        <Perspektive titel={b.titel as string} text={b.text as string} fazit={b.fazit as string} />
      )}
      {b.type === 'verknuepfungen' && <Verknuepfungen eintraege={b.eintraege as any} />}
      {b.type === 'empfehlung' && (
        <Empfehlung
          titel={b.titel as string}
          autor={b.autor as string}
          warum={b.warum as string}
          typ={b.typ as string}
          asin={b.asin as string}
        />
      )}
    </section>
  ))}
</div>
