---
import { markdownZuHtml } from '../../lib/markdown';
import Formatzeichen from '../Formatzeichen.astro';

interface DarunterEintrag {
  titel?: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  frage?: string;
  kernsatz?: string;
  was_passiert?: string;
  woran_merkst?: string;
  was_hilft?: string;
  beleg?: string;
  fazit?: string;
  darauf_aufbauend?: DarunterEintrag[];
}

const { eyebrow, frage, kernsatz, was_passiert, woran_merkst, was_hilft, beleg, fazit, darauf_aufbauend = [] } =
  Astro.props as Props;
---

<div class="baustein-ebene">
  {eyebrow && <p class="ebenen-tabs__eyebrow">{eyebrow}</p>}
  {frage && <h3 class="baustein-ebene__frage">{frage}</h3>}
  {kernsatz && <p class="ebenen-tabs__kernsatz">{kernsatz}</p>}
  {was_passiert && (
    <div class="baustein-ebene__teil">
      <p class="baustein-ebene__label">Was passiert</p>
      <div class="prosa" set:html={markdownZuHtml(was_passiert)} />
    </div>
  )}
  {woran_merkst && (
    <div class="baustein-ebene__teil">
      <p class="baustein-ebene__label">Woran du es merkst</p>
      <div class="prosa" set:html={markdownZuHtml(woran_merkst)} />
    </div>
  )}
  {was_hilft && (
    <div class="baustein-ebene__teil">
      <p class="baustein-ebene__label">Was konkret hilft</p>
      <div class="prosa" set:html={markdownZuHtml(was_hilft)} />
    </div>
  )}
  {beleg && (
    <div class="baustein-ebene__teil">
      <p class="baustein-ebene__label">Beleg</p>
      <div class="prosa" set:html={markdownZuHtml(beleg)} />
    </div>
  )}
  {fazit && <p class="baustein-ebene__fazit">{fazit}</p>}
  {darauf_aufbauend.length > 0 && (
    <div class="baustein-ebene__teil">
      <p class="baustein-ebene__label">Darauf aufbauend</p>
      <ul class="baustein-ebene__aufbauend">
        {darauf_aufbauend.map((e) => {
          const typ = e.href?.startsWith('/essays/') ? 'essays' : 'lexikon';
          return (
            <li>
              {e.href ? (
                <a href={e.href}>
                  <span class="baustein-ebene__aufbauend-typ">
                    <Formatzeichen typ={typ} />
                    {typ === 'essays' ? 'Essay' : 'Lexikon'}
                  </span>
                  <strong>{e.titel}</strong>
                </a>
              ) : (
                <span>{e.titel}</span>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  )}
</div>
