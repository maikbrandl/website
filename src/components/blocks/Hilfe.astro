---
interface Eintrag {
  titel?: string;
  beschreibung?: string;
  url?: string;
}

interface Props {
  eintraege?: Eintrag[];
}

const { eintraege = [] } = Astro.props as Props;
---

<ul class="baustein-hilfe">
  {eintraege.map((e) => (
    <li class="baustein-hilfe__item">
      {e.url ? <a href={e.url}>{e.titel}</a> : <strong>{e.titel}</strong>}
      {e.beschreibung && <span>{e.beschreibung}</span>}
    </li>
  ))}
</ul>
