---
import { iconSvg } from '../../lib/icons';

interface Fakt {
  icon?: string;
  label?: string;
  text?: string;
}

interface Props {
  fakten?: Fakt[];
}

const { fakten = [] } = Astro.props as Props;
---

<div class="baustein-icon-fakten">
  {fakten.map((f) => (
    <div class="baustein-fakt">
      <span class="baustein-fakt__icon" aria-hidden="true" set:html={iconSvg(f.icon)} />
      <span>
        {f.label && <strong class="baustein-fakt__label">{f.label}</strong>}
        {f.text}
      </span>
    </div>
  ))}
</div>
