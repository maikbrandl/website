---
import '../styles/logbuch.css';
import { getCollection } from 'astro:content';

interface JsonLdEntry extends Record<string, unknown> {}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  bild?: string;
  jsonLd?: JsonLdEntry | JsonLdEntry[];
  umami?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).toString(),
  bild,
  jsonLd,
  umami = true,
  noindex = false,
} = Astro.props as Props;

const jsonLdListe = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Wege Klappmenue: aus der bereiche Sammlung, sortiert nach Reihenfolge.
const bereicheEintraege = (await getCollection('bereiche')).sort(
  (a, b) => (a.data.reihenfolge ?? 99) - (b.data.reihenfolge ?? 99),
);

const pfad = Astro.url.pathname;
const rubrik = pfad === '/'
  ? 'start'
  : pfad.startsWith('/wege/') || pfad.startsWith('/bereiche/')
    ? 'wege'
    : (['lexikon', 'essays', 'tools', 'journale', 'suche'].find((r) => pfad.startsWith(`/${r}/`)) ?? '');
const aktiv = (r: string) => (rubrik === r ? 'true' : undefined);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Hybridlog" />
    {bild && <meta property="og:image" content={new URL(bild, Astro.site).toString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLdListe.map((eintrag) => (
      <script type="application/ld+json" set:html={JSON.stringify(eintrag)} />
    ))}

    <!-- Anti-FOUC: Theme so frueh wie moeglich setzen, vor dem ersten Rendern -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hl-theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {}
      })();
    </script>

    <script id="usercentrics-cmp" async data-eu-mode="true" data-settings-id="1v_AzfjqkkRSWa" src="https://app.eu.usercentrics.eu/browser-ui/latest/loader.js"></script>
    {umami && <script defer src="https://cloud.umami.is/script.js" data-website-id="3bde1038-791c-439b-add6-c17949c3d315" data-domains="hybridlog.de"></script>}
    <script defer src="/js/track.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>

    <header class="kopfleiste">
      <div class="container kopfleiste__inner">
        <a href="/" class="logo">hybrid<span class="marker--flaeche">log</span></a>

        <nav class="hauptnav" aria-label="Hauptnavigation">
          <ul class="hauptnav__liste">
            <li class="wege-nav">
              <button
                type="button"
                class="wege-toggle"
                data-aktiv={aktiv('wege')}
                data-disclosure-trigger
                aria-expanded="false"
                aria-controls="wege-panel"
              >
                Wege
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
              <div id="wege-panel" class="wege-panel" data-disclosure-panel hidden>
                <ul>
                  {bereicheEintraege.map((b) => (
                    <li>
                      <a href={`/bereiche/${b.id}/`}>
                        <strong>{b.data.title}</strong><br />
                        <small>{b.data.beschreibung}</small>
                      </a>
                    </li>
                  ))}
                  <li>
                    <a class="wege-panel__alle" href="/wege/">Alle Wissenswege ansehen</a>
                  </li>
                </ul>
              </div>
            </li>
            <li><a href="/lexikon/" aria-current={aktiv('lexikon')}>Lexikon</a></li>
            <li class="hauptnav__neben"><a href="/essays/" aria-current={aktiv('essays')}>Essays</a></li>
            <li class="hauptnav__neben"><a href="/tools/" aria-current={aktiv('tools')}>Tools</a></li>
            <li class="hauptnav__neben"><a href="/journale/" aria-current={aktiv('journale')}>Journale</a></li>
          </ul>
        </nav>

        <form class="suchformular" action="/suche/" method="get" role="search">
          <svg class="suchformular__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.3-4.3" />
          </svg>
          <label class="nur-sr" for="suche-eingabe">Suche</label>
          <input id="suche-eingabe" type="search" name="q" placeholder="Frage oder Begriff suchen" />
          <button class="nur-sr" type="submit">Suchen</button>
        </form>

        <button
          type="button"
          class="iconbtn"
          data-theme-toggle
          aria-pressed="false"
          aria-label="Zu dunklem Design wechseln"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>

        <button
          type="button"
          class="iconbtn menu-toggle"
          data-disclosure-trigger
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menue oeffnen"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </button>
      </div>

      <div id="mobile-menu" class="mobile-menu container" data-disclosure-panel hidden>
        <ul class="mobile-menu__liste">
          <li><a href="/">Start</a></li>
          <li><a href="/wege/">Wege</a></li>
          <li><a href="/lexikon/">Lexikon</a></li>
          <li><a href="/essays/">Essays</a></li>
          <li><a href="/tools/">Tools</a></li>
          <li><a href="/journale/">Journale</a></li>
        </ul>
        <ul class="mobile-menu__bereiche">
          {bereicheEintraege.map((b) => (
            <li><a href={`/bereiche/${b.id}/`}>{b.data.title}</a></li>
          ))}
        </ul>
        <form class="suchformular-mobil" action="/suche/" method="get" role="search">
          <svg class="suchformular__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.3-4.3" />
          </svg>
          <label class="nur-sr" for="suche-eingabe-mobil">Suche</label>
          <input id="suche-eingabe-mobil" type="search" name="q" placeholder="Frage oder Begriff suchen" />
          <button class="nur-sr" type="submit">Suchen</button>
        </form>
      </div>
    </header>

    <main id="hauptinhalt">
      <slot />
    </main>

    <footer class="fusszeile">
      <div class="container fusszeile__inner">
        <p class="fusszeile__ueber">
          Hybridlog ist eine deutschsprachige Wissensplattform ueber den Menschen: Wissenswege,
          Lexikon, Essays, Tools und eigene Journale.
        </p>
        <div class="fusszeile__recht">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
          <button type="button" onclick="window.UC_UI && window.UC_UI.showSecondLayer()">Cookie-Einstellungen</button>
        </div>
      </div>
    </footer>

    <nav class="mobil-tableiste" aria-label="Mobile Navigation">
      <a href="/" aria-current={aktiv('start')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11l8-7 8 7" />
          <path d="M6 10v10h12V10" />
        </svg>
        Start
      </a>
      <a href="/wege/" aria-current={aktiv('wege')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6.5 17.5c3-2 4-6 11-11" />
          <circle cx="5" cy="19" r="2" />
          <circle cx="19" cy="5" r="2" />
        </svg>
        Wege
      </a>
      <a href="/lexikon/" aria-current={aktiv('lexikon')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 4h14a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-8l-5 4v-4H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" />
        </svg>
        Lexikon
      </a>
      <a href="/suche/" aria-current={aktiv('suche')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" />
        </svg>
        Suche
      </a>
    </nav>

    <script>
      // Auf- und zuklappbare Menues: Wege-Klappmenue, mobiles Menue. Tastatur und Escape bedienbar.
      const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-disclosure-trigger]'));

      function schliessen(trigger: HTMLButtonElement) {
        const panelId = trigger.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        trigger.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      }

      function oeffnen(trigger: HTMLButtonElement) {
        const panelId = trigger.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        trigger.setAttribute('aria-expanded', 'true');
        if (panel) panel.hidden = false;
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const istOffen = trigger.getAttribute('aria-expanded') === 'true';
          triggers.forEach((t) => t !== trigger && schliessen(t));
          if (istOffen) {
            schliessen(trigger);
          } else {
            oeffnen(trigger);
          }
        });
      });

      document.addEventListener('keydown', (ev) => {
        if (ev.key !== 'Escape') return;
        const offenerTrigger = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
        if (offenerTrigger) {
          schliessen(offenerTrigger);
          offenerTrigger.focus();
        }
      });

      document.addEventListener('click', (ev) => {
        const ziel = ev.target as Node;
        triggers.forEach((trigger) => {
          if (trigger.getAttribute('aria-expanded') !== 'true') return;
          const panelId = trigger.getAttribute('aria-controls');
          const panel = panelId ? document.getElementById(panelId) : null;
          if (!panel) return;
          if (trigger.contains(ziel) || panel.contains(ziel)) return;
          schliessen(trigger);
        });
      });

      // Theme Umschalter
      const themeSchalter = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      function systemBevorzugtDunkel() {
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      }
      function aktuellesTheme() {
        const gesetzt = document.documentElement.getAttribute('data-theme');
        if (gesetzt === 'light' || gesetzt === 'dark') return gesetzt;
        return systemBevorzugtDunkel() ? 'dark' : 'light';
      }
      function themeAktualisieren() {
        if (!themeSchalter) return;
        const istDunkel = aktuellesTheme() === 'dark';
        themeSchalter.setAttribute('aria-pressed', String(istDunkel));
        themeSchalter.setAttribute('aria-label', istDunkel ? 'Zu hellem Design wechseln' : 'Zu dunklem Design wechseln');
      }
      themeAktualisieren();
      themeSchalter?.addEventListener('click', () => {
        const neu = aktuellesTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', neu);
        try {
          localStorage.setItem('hl-theme', neu);
        } catch (e) {}
        themeAktualisieren();
      });
    </script>
  </body>
</html>
