---
import Base from '../../layouts/Base.astro';
import Brotkrumen from '../../components/Brotkrumen.astro';
import { breadcrumbListJsonLd } from '../../lib/jsonld';
// @ts-ignore - Vite raw Import, einmalig aus legacy/datenschutz.html portiert, ohne Umami Abschnitt.
import datenschutzHtml from '../../content-extracted/datenschutz.html?raw';

const titel = 'Datenschutz · Hybridlog';
const beschreibung = 'Datenschutzerklärung von Hybridlog nach Art. 13 DSGVO.';
const canonical = new URL('/datenschutz/', Astro.site).toString();

const jsonLd = [
  breadcrumbListJsonLd([
    { name: 'Start', url: new URL('/', Astro.site).toString() },
    { name: 'Datenschutz' },
  ]),
];
---

<Base title={titel} description={beschreibung} canonical={canonical} jsonLd={jsonLd} umami={false}>
  <div class="container stack-gross">
    <Brotkrumen items={[{ label: 'Start', href: '/' }, { label: 'Datenschutz' }]} />

    <header class="tool-kopf">
      <h1>Datenschutzerklärung</h1>
    </header>

    <div class="prosa legal-inhalt" set:html={datenschutzHtml} />
  </div>
</Base>
