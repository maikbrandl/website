---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Brotkrumen from '../../components/Brotkrumen.astro';
import Formatzeichen from '../../components/Formatzeichen.astro';
import { formatiereDatum } from '../../lib/datum';
import { breadcrumbListJsonLd, collectionPageJsonLd } from '../../lib/jsonld';

const bereicheNamen = new Map(
  (await getCollection('bereiche')).map((b) => [b.id, b.data.title ?? b.id]),
);

const essays = (await getCollection('posts'))
  .filter((p) => p.data.url)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const canonical = new URL('/essays/', Astro.site).toString();
const titel = 'Essays · Hybridlog';
const beschreibung = 'Alle Essays von Hybridlog, von Lernstrategien bis Philosophie.';

const jsonLd = [
  collectionPageJsonLd({ name: titel, description: beschreibung, url: canonical }),
  breadcrumbListJsonLd([
    { name: 'Start', url: new URL('/', Astro.site).toString() },
    { name: 'Essays' },
  ]),
];
---

<Base title={titel} description={beschreibung} canonical={canonical} jsonLd={jsonLd}>
  <div class="container stack-gross">
    <Brotkrumen items={[{ label: 'Start', href: '/' }, { label: 'Essays' }]} />

    <header class="lexikon-kopf">
      <p class="lexikon-kopf__label"><Formatzeichen typ="essays" /> Essays</p>
      <h1>Essays</h1>
      <p class="prosa">
        {essays.length} Essays, die ein Thema ausführlich und persönlich durchdenken.
      </p>
    </header>

    <ul class="essay-liste">
      {essays.map((essay) => (
        <li class="essay-karte">
          <a href={`/essays/${essay.data.url}/`}>
            <p class="essay-karte__meta">
              {essay.data.bereich && <span>{bereicheNamen.get(essay.data.bereich) ?? essay.data.bereich}</span>}
              {essay.data.date && <span>{formatiereDatum(essay.data.date.toISOString())}</span>}
            </p>
            <strong>{essay.data.title}</strong>
            {essay.data.excerpt && <span class="essay-karte__teaser">{essay.data.excerpt}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
