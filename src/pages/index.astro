---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Formatzeichen from '../components/Formatzeichen.astro';
import Marker from '../components/Marker.astro';
import ToolVorschau from '../components/ToolVorschau.astro';
import { pruefeEintraege } from '../lib/contentWarnings';
import { formatiereDatum } from '../lib/datum';
import { organizationJsonLd, websiteJsonLd } from '../lib/jsonld';
import { TOOLS_UEBERSICHT } from '../lib/toolsUebersicht';
import { JOURNALE } from '../lib/journale';
import { klartext } from '../lib/markdown';

const themen = await getCollection('themen');
const fachgebiete = await getCollection('fachgebiete');
const posts = await getCollection('posts');
const wissensfragen = await getCollection('wissensfragen');
const bereiche = await getCollection('bereiche');

let warnungen = 0;
warnungen += pruefeEintraege('themen', themen, ['title']);
warnungen += pruefeEintraege('fachgebiete', fachgebiete, ['title']);
warnungen += pruefeEintraege('posts', posts, ['title']);
warnungen += pruefeEintraege('wissensfragen', wissensfragen, ['title']);
warnungen += pruefeEintraege('bereiche', bereiche, ['title', 'beschreibung', 'reihenfolge']);

console.log(
  `Build: ${themen.length} Themen, ${fachgebiete.length} Fachgebiete, ${posts.length} Essays, ` +
    `${wissensfragen.length} Wissensfrage${wissensfragen.length === 1 ? '' : 'n'}, ${bereiche.length} Bereiche, ` +
    `${warnungen} Warnung${warnungen === 1 ? '' : 'en'}.`,
);

const sechsBereiche = bereiche
  .sort((a, b) => (a.data.reihenfolge ?? 99) - (b.data.reihenfolge ?? 99))
  .slice(0, 6);

const wegeProBereich = new Map<string, number>();
for (const w of wissensfragen) {
  if (!w.data.bereich) continue;
  wegeProBereich.set(w.data.bereich, (wegeProBereich.get(w.data.bereich) ?? 0) + 1);
}

const beliebteWege = wissensfragen.slice(0, 3);
if (beliebteWege.length < 3) {
  console.warn(`Startseite: nur ${beliebteWege.length} Wissenswege verfuegbar, geplant sind 3.`);
}

const beliebteThemen = themen
  .sort((a, b) => (a.data.title ?? a.id).localeCompare(b.data.title ?? b.id, 'de'))
  .slice(0, 6);

const neueEssays = posts
  .filter((p) => p.data.url)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 2);

const titel = 'Hybridlog · Wissen über den Menschen';
const beschreibung =
  'Hybridlog beantwortet echte Fragen über den Menschen gründlich, mit einem Lexikon, Wissenswegen, Essays und interaktiven Tools.';
const canonical = new URL('/', Astro.site).toString();

const jsonLd = [organizationJsonLd(), websiteJsonLd()];
---

<Base title={titel} description={beschreibung} canonical={canonical} jsonLd={jsonLd}>
  <section class="start-hero">
    <div class="container start-hero__inner">
      <h1>Was beschäftigt dich <Marker>gerade</Marker>?</h1>
      <p class="prosa start-hero__lead">
        Hybridlog beantwortet echte Lebensfragen aus Psychologie, Lernen und Philosophie. Jede
        Ebene erklärt, jede Aussage belegt.
      </p>
      <form class="suchformular start-hero__suche" action="/suche/" method="get" role="search">
        <svg class="suchformular__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" />
        </svg>
        <label class="nur-sr" for="start-suche">Suche</label>
        <input id="start-suche" type="search" name="q" placeholder="z. B. Warum schiebe ich alles auf?" />
        <button class="nur-sr" type="submit">Suchen</button>
      </form>
      {beliebteWege.length > 0 && (
        <div class="start-hero__beispiele">
          {beliebteWege.map((w) => (
            <a href={`/wege/${w.id}/`}>{w.data.title ?? w.id}</a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="container stack-gross">
    <section class="start-abschnitt">
      <div class="start-abschnitt__kopf">
        <h2>Lebensbereiche</h2>
      </div>
      <div class="start-bereiche-grid">
        {sechsBereiche.map((b) => {
          const anzahl = wegeProBereich.get(b.id) ?? 0;
          return (
            <a class="start-bereich-karte" href={`/bereiche/${b.id}/`}>
              <strong>{b.data.title}</strong>
              <span class="start-bereich-karte__anzahl">{anzahl} {anzahl === 1 ? 'Weg' : 'Wege'}</span>
            </a>
          );
        })}
      </div>
    </section>

    {beliebteWege.length > 0 && (
      <section class="start-abschnitt">
        <div class="start-abschnitt__kopf">
          <h2>Beliebte Wege</h2>
          <a href="/wege/">Alle Wege →</a>
        </div>
        <div class="start-wege-grid">
          {beliebteWege.map((w) => {
            const gesamtzeit = (w.data.kurzlesezeit ?? 0) + (w.data.vertiefzeit ?? 0);
            const ebenen = (w.data.bloecke ?? []).filter((b) => b.type === 'perspektive' || b.type === 'ebene').length;
            return (
              <a class="start-weg-karte" href={`/wege/${w.id}/`}>
                <p class="start-weg-karte__meta">
                  <Formatzeichen typ="wege" /> Wissensweg{gesamtzeit > 0 && ` · ${gesamtzeit} Min.`}
                </p>
                <strong>{w.data.title}</strong>
                {(w.data.kurzantwort || w.data.lead) && <span>{klartext(w.data.kurzantwort || w.data.lead)}</span>}
                {ebenen > 0 && (
                  <p class="start-weg-karte__fortschritt">
                    {Array.from({ length: ebenen }).map(() => <span data-gefuellt="" />)}
                  </p>
                )}
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="start-abschnitt">
      <div class="start-abschnitt__kopf">
        <h2>Ausprobieren</h2>
        <a href="/tools/">Alle Tools →</a>
      </div>
      <div class="tools-grid">
        {TOOLS_UEBERSICHT.map((tool) => (
          <a class="tool-karte" href={tool.href}>
            <div class="tool-karte__vorschau">
              <ToolVorschau typ={tool.vorschau} />
            </div>
            <div class="tool-karte__body">
              <span class="tool-karte__label">{tool.label}</span>
              <h3 class="tool-karte__titel">{tool.titel}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="start-abschnitt">
      <div class="start-abschnitt__kopf">
        <h2>Lexikon: kurz erklärt</h2>
        <a href="/lexikon/">Alle Einträge →</a>
      </div>
      <ul class="lexikon-fachgebiete">
        {beliebteThemen.map((t) => (
          <li>
            <a href={`/lexikon/${t.id}/`}>
              <strong>{t.data.title ?? t.id}</strong>
              {t.data.lead && <span>{klartext(t.data.lead)}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    {neueEssays.length > 0 && (
      <section class="start-abschnitt">
        <div class="start-abschnitt__kopf">
          <h2>Neue Essays</h2>
          <a href="/essays/">Alle Essays →</a>
        </div>
        <ul class="essay-liste">
          {neueEssays.map((essay) => (
            <li class="essay-karte">
              <a href={`/essays/${essay.data.url}/`}>
                <p class="essay-karte__meta">
                  {essay.data.date && <span>{formatiereDatum(essay.data.date.toISOString())}</span>}
                </p>
                <strong>{essay.data.title}</strong>
                {essay.data.excerpt && <span class="essay-karte__teaser">{essay.data.excerpt}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="start-abschnitt" id="produkte">
      <h2>Journale von Hybridlog</h2>
      <div class="journal-grid">
        {JOURNALE.map((j) => (
          <a class="journal-karte" href={`/journale/${j.slug}/`}>
            <div class="journal-karte__bild">
              <img src={j.bild} alt={`Hybridlog ${j.titel}`} loading="lazy" decoding="async" />
            </div>
            <div class="journal-karte__body">
              <h3 class="journal-karte__titel">{j.titel}</h3>
              <p class="journal-karte__meta">
                {j.seiten} Seiten · {j.format} · {j.einband}
              </p>
              <span class="journal-karte__cta">Ansehen</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </section>
</Base>
