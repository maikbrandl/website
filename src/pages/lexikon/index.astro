---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Brotkrumen from '../../components/Brotkrumen.astro';
import Formatzeichen from '../../components/Formatzeichen.astro';
import { breadcrumbListJsonLd, collectionPageJsonLd } from '../../lib/jsonld';

const alleThemen = (await getCollection('themen')).sort((a, b) =>
  (a.data.title ?? a.id).localeCompare(b.data.title ?? b.id, 'de'),
);

const fachgebiete = (await getCollection('fachgebiete'))
  .filter((f) => f.data.visibility === 'public')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const gruppen = new Map<string, typeof alleThemen>();
for (const eintrag of alleThemen) {
  const titel = eintrag.data.title ?? eintrag.id;
  const buchstabe = titel.charAt(0).toUpperCase();
  const liste = gruppen.get(buchstabe) ?? [];
  liste.push(eintrag);
  gruppen.set(buchstabe, liste);
}
const buchstaben = Array.from(gruppen.keys()).sort((a, b) => a.localeCompare(b, 'de'));

const canonical = new URL('/lexikon/', Astro.site).toString();
const titel = 'Lexikon · Kurz erklärt von A bis Z · Hybridlog';
const beschreibung = 'Alle Lexikoneinträge von Hybridlog, von A bis Z, sortiert nach Fachgebiet.';

const jsonLd = [
  collectionPageJsonLd({ name: titel, description: beschreibung, url: canonical }),
  breadcrumbListJsonLd([
    { name: 'Start', url: new URL('/', Astro.site).toString() },
    { name: 'Lexikon' },
  ]),
];
---

<Base title={titel} description={beschreibung} canonical={canonical} jsonLd={jsonLd}>
  <div class="container stack-gross">
    <Brotkrumen items={[{ label: 'Start', href: '/' }, { label: 'Lexikon' }]} />

    <header class="lexikon-kopf">
      <p class="lexikon-kopf__label"><Formatzeichen typ="lexikon" /> Lexikon</p>
      <h1>Kurz erklärt, von A bis Z</h1>
      <p class="prosa">
        {alleThemen.length} Begriffe aus Psychologie, Lernen und Philosophie, jeder für sich kurz
        erklärt und mit den passenden Wegen und Fachgebieten verknüpft.
      </p>
    </header>

    <section class="lexikon-abschnitt">
      <h2>Nach Fachgebiet</h2>
      <ul class="lexikon-fachgebiete">
        {fachgebiete.map((f) => (
          <li>
            <a href={`/lexikon/fachgebiet/${f.id}/`}>
              <strong>{f.data.title}</strong>
              {f.data.description && <span>{f.data.description}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="lexikon-abschnitt">
      <h2>Von A bis Z</h2>
      <nav class="lexikon-az-sprung" aria-label="Zu Buchstabe springen">
        {buchstaben.map((b) => (
          <a href={`#buchstabe-${b}`}>{b}</a>
        ))}
      </nav>
      <div class="lexikon-az">
        {buchstaben.map((b) => (
          <div class="lexikon-az__gruppe" id={`buchstabe-${b}`}>
            <p class="lexikon-az__buchstabe">{b}</p>
            <ul>
              {gruppen.get(b)!.map((eintrag) => (
                <li>
                  <a href={`/lexikon/${eintrag.id}/`}>{eintrag.data.title ?? eintrag.id}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
