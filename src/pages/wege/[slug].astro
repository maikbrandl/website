---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Brotkrumen from '../../components/Brotkrumen.astro';
import Kurzantwort from '../../components/Kurzantwort.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { berechneAbschnitte } from '../../lib/bausteine';
import { formatiereDatum } from '../../lib/datum';
import { markdownInline } from '../../lib/markdown';
import { breadcrumbListJsonLd, articleJsonLd, faqPageJsonLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const wege = await getCollection('wissensfragen');
  return wege.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const daten = entry.data;

const bereich = daten.bereich ? await getEntry('bereiche', daten.bereich) : undefined;

const abschnitte = berechneAbschnitte(daten.bloecke);
const ebenen = abschnitte.filter((a) => a.block.type === 'ebene');
const quellen = daten.quellen ?? [];

// Verzeichnis: Ebenen mit Nummer und Kurzname, Zitate und Angebote bleiben draussen.
let ebeneZaehler = 0;
const tocEintraege: { id: string; titel: string; ebene?: number }[] = [
  ...(daten.kurzantwort ? [{ id: 'kurz-beantwortet', titel: 'Kurz beantwortet' }] : []),
  ...abschnitte
    .filter((a) => a.block.type !== 'zitat' && a.block.type !== 'angebot')
    .map((a) => {
      if (a.block.type !== 'ebene') return { id: a.id, titel: a.titel };
      ebeneZaehler += 1;
      const label = (a.block.label as string) || a.titel;
      return { id: a.id, titel: `${ebeneZaehler} · ${label}`, ebene: ebeneZaehler };
    }),
  ...(quellen.length > 0 ? [{ id: 'quellen', titel: 'Quellen' }] : []),
];

const faqEintraege = (daten.bloecke ?? [])
  .filter((b): b is typeof b & { eintraege: { frage?: string; antwort?: string }[] } => b.type === 'faq')
  .flatMap((b) => b.eintraege ?? [])
  .filter((e): e is { frage: string; antwort: string } => Boolean(e.frage && e.antwort));

const geprueftAmText = formatiereDatum(daten.geprueft_am);

const titel = daten.seo_title || `${daten.title} · Hybridlog`;
const beschreibung = daten.seo_description || daten.kurzantwort || daten.lead || daten.title || 'Ein Wissensweg von Hybridlog.';
const canonical = new URL(`/wege/${entry.id}/`, Astro.site).toString();

const jsonLd: Record<string, unknown>[] = [
  articleJsonLd({
    headline: daten.title ?? entry.id,
    description: beschreibung,
    url: canonical,
    datumGeprueft: daten.geprueft_am,
  }),
  breadcrumbListJsonLd([
    { name: 'Start', url: new URL('/', Astro.site).toString() },
    { name: 'Bereiche', url: new URL('/bereiche/', Astro.site).toString() },
    ...(bereich
      ? [{ name: bereich.data.title ?? bereich.id, url: new URL(`/bereiche/${bereich.id}/`, Astro.site).toString() }]
      : []),
    { name: daten.title ?? entry.id },
  ]),
];
if (faqEintraege.length > 0) {
  jsonLd.push(faqPageJsonLd(faqEintraege));
}
---

<Base title={titel} description={beschreibung} canonical={canonical} jsonLd={jsonLd}>
  <div class="container weg-seite">
    <Brotkrumen
      items={[
        { label: 'Wege', href: '/wege/' },
        ...(bereich ? [{ label: bereich.data.title ?? bereich.id, href: `/bereiche/${bereich.id}/` }] : []),
      ]}
    />

    <div data-pagefind-body data-pagefind-filter="Format:Weg">
    <header class="weg-kopf">
      <h1>{daten.title}</h1>

      {daten.kurzantwort && (
        <Kurzantwort><p set:html={markdownInline(daten.kurzantwort)} /></Kurzantwort>
      )}

      <p class="lexikon-meta">
        <span>Von {daten.autor || 'Maik'}</span>
        {geprueftAmText && <span>geprüft am {geprueftAmText}</span>}
        {(daten.vertiefzeit || daten.kurzlesezeit) && (
          <span>{daten.vertiefzeit || daten.kurzlesezeit} Min.</span>
        )}
        {quellen.length > 0 && (
          <span>{quellen.length} Quelle{quellen.length === 1 ? '' : 'n'}</span>
        )}
      </p>
    </header>

    {ebenen.length > 0 && (
      <nav class="ebenen-leiste" aria-label="Ebenen dieses Wegs" style={`--anzahl: ${ebenen.length}`}>
        {ebenen.map((a, i) => (
          <a class="ebenen-leiste__tab" href={`#${a.id}`}>
            {i + 1} · {(a.block.label as string) || a.titel}
          </a>
        ))}
      </nav>
    )}

    <div class="weg-layout">
      <div class="weg-haupt">
        <BlockRenderer bloecke={daten.bloecke} ebenenLeiste={false} />

        {quellen.length > 0 && (
          <section class="baustein-sektion" id="quellen">
            <p class="baustein-sektion__label">Quellen</p>
            <ul class="lexikon-liste">
              {quellen.map((q) => (
                <li>
                  {q.url ? (
                    <a href={q.url} target="_blank" rel="noopener">{q.titel}</a>
                  ) : (
                    <span>{q.titel}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      {tocEintraege.length > 0 && (
        <nav class="weg-toc" aria-label="Verzeichnis der Abschnitte">
          <p class="lexikon-sidebar__label">Auf dieser Seite</p>
          <ul>
            {tocEintraege.map((a) => (
              <li><a href={`#${a.id}`} data-ebene={a.ebene}>{a.titel}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
    </div>
  </div>
</Base>
